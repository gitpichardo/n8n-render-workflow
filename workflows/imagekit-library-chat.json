      "parameters": {
        "promptType": "auto",
        "options": {
          "systemMessage": "You are a helpful assistant for browsing an ImageKit media library. You can search and list files, look up what custom metadata fields exist, and search ImageKit's documentation. Always use your tools to answer questions about the actual library contents rather than guessing. When you mention a file, include its `url` field so the user can open it."
        }
      },
      "id": "a1a1a1a1-0003-4000-8000-000000000003",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [80, 0]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-4-5-20250929",
          "cachedResultName": "Claude Sonnet 4.5"
        },
        "options": {}
      },
      "id": "a1a1a1a1-0004-4000-8000-000000000004",
      "name": "Anthropic Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [-40, 220],
      "notes": "Placeholder credential. Open this node after import and attach (or create) an 'Anthropic' credential with your API key. See README > First login setup."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.imagekit.io/v1/files",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "searchQuery",
              "value": "={{ $fromAI('searchQuery', 'Lucene-like search query over the media library, e.g. tags IN [\"approved\"] or createdAt >= \"7d\". Omit to list without filtering.', 'string') }}"
            },
            {
              "name": "path",
              "value": "={{ $fromAI('path', 'Folder path to limit the search, e.g. /campaigns. Omit to search the whole library.', 'string') }}"
            },
            {
              "name": "limit",
              "value": "={{ $fromAI('limit', 'Maximum number of results to return, 1-100.', 'number', 20) }}"
            }
          ]
        },
        "sendHeaders": false,
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {}
      },
      "id": "a1a1a1a1-0005-4000-8000-000000000005",
      "name": "List/Search Media Library",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [80, 220],
      "notes": "No credential attached on import. Open this node, create an HTTP Basic Auth credential with your ImageKit private key as the username and an empty password, and select it here. See README > First login setup."
