# These map to render.yaml's envVars. Render fills most of these in
# automatically on deploy (generateValue / fromDatabase / fromService); this
# file documents them for local Docker runs and so a fresh fork's env is
# self-explanatory. Nothing ImageKit-specific goes here -- ImageKit and LLM
# credentials are attached in the n8n editor UI after first login, not as
# container env vars. See README > First login setup.

# --- n8n core ---

# Encrypts credentials at rest in the database. Generate one with
# `openssl rand -hex 32`. NEVER change this after first deploy -- every
# credential already saved becomes unreadable if you do.
N8N_ENCRYPTION_KEY=

# --- Postgres (Render fills these in via fromDatabase on a real deploy) ---

DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=

# --- Public URL (Render fills these in via fromService on a real deploy) ---

# Hostname only, no scheme, e.g. my-n8n.onrender.com
N8N_HOST=localhost
N8N_PROTOCOL=http
# Full URL with scheme, used for webhook registration.
WEBHOOK_URL=http://localhost:5678/

# --- ImageKit DevTools MCP (public, no auth -- not a secret) ---

IMAGEKIT_MCP_URL=https://devtools-mcp.imagekit.io/mcp
